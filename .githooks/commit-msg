#
# Runs on every commit's message, on a machine that has opted in once with
#
#   git config core.hooksPath .githooks
#
# and refuses a commit that names a tool as a person, or that is not signed
# off (AGENTS.md, Never: every commit is `git commit -s`, and no tool is named
# in a commit).
#
# Why a hook: the rule was written down twice and was broken anyway. A session
# working on a cloud copy committed as the tool it was — author, committer and
# sign-off all a tool's name and address — and three such commits reached
# main before anybody looked, 2026-10-01 and 2026-10-13. GitHub lists a
# commit's author as a contributor to the project, so the fix was a rewrite
# of main's history and a force-push. A hook is asked every time, however the
# commit was typed.
#
# What it reads: the author and committer git is about to record, and the
# message's trailers (Signed-off-by, Co-authored-by) and any "Generated with"
# line. Not the rest of the message, which may talk about a tool by name.
# The names are tools', never a person's: nobody's real name is in this file.
#
# The file's name is git's (commit-msg); the folder's is ours.

TOOLS='claude|anthropic|copilot|chatgpt|openai|codex|gemini|cursor|devin|aider'

refuse() {
  echo
  echo "Commit refused: $1"
  echo "Commit as the person who keeps this copy: git config user.name and"
  echo "git config user.email are theirs, and the commit is made with -s."
  exit 1
}

for who in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  if printf '%s\n' "$who" | grep -Eiq "$TOOLS"; then
    refuse "it would be recorded as made by a tool ($(printf '%s' "$who" | sed 's/ [0-9]* [-+][0-9]*$//'))."
  fi
done

if grep -Ei '^(signed-off-by|co-authored-by):' "$1" | grep -Eiq "$TOOLS"; then
  refuse "a trailer names a tool as an author or as signing off."
fi
if grep -Eiq '^[^a-z]*generated (with|by) ' "$1"; then
  refuse "the message says it was generated by a tool."
fi

if ! grep -Eiq '^signed-off-by: ' "$1"; then
  refuse "it is not signed off. Commit with git commit -s (a merge: git merge --signoff)."
fi

exit 0
